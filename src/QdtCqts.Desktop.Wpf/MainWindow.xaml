<Window x:Class="QdtCqts.Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QdtCqts.Desktop.Wpf"
        xmlns:vm="clr-namespace:QdtCqts.Desktop.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="sisQDT_LIGHT — Sistema Unificado de Cálculo Elétrico" 
        Icon="Assets/sisQDT_LIGHT.ico" 
        Height="780" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="HeaderBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="CardBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#334155"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#0284C7"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#38BDF8"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="WarningAmber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0. Header bar -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Action bar (projeto, botão, status) -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Metrics cards -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Central Working Area: Unifilar + Detalhes -->
            <RowDefinition Height="2*" MinHeight="260"/>
            <!-- 4. Splitter -->
            <RowDefinition Height="5"/>
            <!-- 5. Bottom Panel: Segments DataGrid -->
            <RowDefinition Height="1*" MinHeight="140"/>
            <!-- 6. Footer bar (Traceability) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Header Bar -->
        <Border Grid.Row="0" Background="#0B1120" Padding="18,12" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Image Source="Assets/sisQDT_LIGHT.png" Height="36" DockPanel.Dock="Left" Margin="0,0,16,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="sisQDT_LIGHT" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Cálculo Elétrico Unificado de Queda de Tensão, Curto-Circuito e Proteção" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 1. Controls & Actions -->
        <Border Grid.Row="1" Background="{StaticResource HeaderBg}" Padding="18,12" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Projeto Real:" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableProjects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                          Background="#0F172A" Foreground="#FFFFFF" Padding="8,6" FontSize="13" Height="34" VerticalContentAlignment="Center"/>

                <Button Grid.Column="2" Command="{Binding ExecuteCalculationCommand}" Margin="16,0,0,0"
                        Background="#0284C7" Foreground="#FFFFFF" Padding="20,6" Height="34" FontWeight="Bold" FontSize="13" Cursor="Hand" BorderThickness="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡ Executar Cálculo"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Status: " Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                    <Border CornerRadius="12" Padding="12,4" Background="{Binding StatusColor}">
                        <TextBlock Text="{Binding CalculationStatus}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Metrics Cards -->
        <Grid Grid.Row="2" Margin="18,12,18,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Queda de Tensão Máxima -->
            <Border Grid.Column="0" Background="{StaticResource CardBg}" CornerRadius="8" Padding="12" Margin="0,0,8,0" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="QUEDA DE TENSÃO MÁXIMA" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding MaxVoltageDropPercent, StringFormat='{}{0:F2} %'}" Foreground="{StaticResource AccentCyan}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Text="Acumulada na ponta da BT" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Curto-Circuito Trifásico Máximo -->
            <Border Grid.Column="1" Background="{StaticResource CardBg}" CornerRadius="8" Padding="12" Margin="4,0,4,0" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="CURTO-CIRCUITO TRIFÁSICO (Icc 3φ)" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding MaxShortCircuit3PhaseAmperes, StringFormat='{}{0:F0} A'}" Foreground="#38BDF8" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Text="Saída do transformador" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Curto-Circuito Monofásico Mínimo -->
            <Border Grid.Column="2" Background="{StaticResource CardBg}" CornerRadius="8" Padding="12" Margin="4,0,4,0" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="CURTO-CIRCUITO MONOFÁSICO (Icc 1φ)" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding MinShortCircuit1PhaseAmperes, StringFormat='{}{0:F0} A'}" Foreground="#FBBF24" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Text="Sensibilidade na ponta (BTG)" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Proteção Fusível NH -->
            <Border Grid.Column="3" Background="{StaticResource CardBg}" CornerRadius="8" Padding="12" Margin="8,0,0,0" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="AVALIAÇÃO POR CURVA DE PROTEÇÃO" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding AssessedProtectionDevice}" Foreground="#FBBF24" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding ProtectionStatus}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Central Working Area: Unifilar + Painel de Detalhes -->
        <Grid Grid.Row="3" Margin="18,0,18,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="340" MinWidth="260" MaxWidth="480"/>
            </Grid.ColumnDefinitions>

            <!-- 3A. Unifilar Diagram Canvas Area -->
            <Border Grid.Column="0" Background="#0A0F1D" CornerRadius="8" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <!-- Toolbar do Diagrama Unifilar (Zoom/Pan/Fit/Legenda) -->
                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12" Background="#1E293B" CornerRadius="6" Padding="6,4" Panel.ZIndex="10" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Diagrama Unifilar" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="6,0,12,0"/>
                            
                            <Button x:Name="BtnZoomIn" Click="BtnZoomIn_Click" Content="➕" ToolTip="Aproximar (Zoom In)"
                                    Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#334155" BorderThickness="1" Width="28" Height="26" Margin="2,0" Cursor="Hand"/>
                            <Button x:Name="BtnZoomOut" Click="BtnZoomOut_Click" Content="➖" ToolTip="Afastar (Zoom Out)"
                                    Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#334155" BorderThickness="1" Width="28" Height="26" Margin="2,0" Cursor="Hand"/>
                            <Button x:Name="BtnResetZoom" Click="BtnResetZoom_Click" Content="1:1" ToolTip="Zoom 100%"
                                    Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#334155" BorderThickness="1" Width="34" Height="26" Margin="2,0" Cursor="Hand" FontSize="11"/>
                            <Button x:Name="BtnFitView" Click="BtnFitView_Click" Content="⛶ Ajustar" ToolTip="Enquadrar à Tela (Fit to View)"
                                    Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" Height="26" Padding="8,2" Margin="4,0" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>

                            <TextBlock Text="{Binding UnifilarDiagram.ZoomLevel, StringFormat='{}{0:P0}'}" Foreground="{StaticResource AccentCyan}"
                                       VerticalAlignment="Center" Margin="8,0,6,0" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Mensagem quando o unifilar ainda não foi gerado -->
                    <Border Background="#0A0F1D" Visibility="{Binding UnifilarDiagram, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <!-- Visible only when diagram is null in reverse, managed by trigger below -->
                    </Border>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="1">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UnifilarDiagram}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="⚡" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="Diagrama Unifilar Operacional" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Clique em 'Executar Cálculo' para projetar o grafo elétrico da rede." FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Área Interativa de Zoom/Pan -->
                    <Border x:Name="ViewportBorder" Background="Transparent" ClipToBounds="True"
                            MouseWheel="Viewport_MouseWheel"
                            MouseDown="Viewport_MouseDown"
                            MouseMove="Viewport_MouseMove"
                            MouseUp="Viewport_MouseUp">
                        <Canvas x:Name="DiagramCanvas" Width="2000" Height="1400" Background="#0A0F1D">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CanvasScale"
                                                    ScaleX="{Binding UnifilarDiagram.ZoomLevel, FallbackValue=1.0}"
                                                    ScaleY="{Binding UnifilarDiagram.ZoomLevel, FallbackValue=1.0}"/>
                                    <TranslateTransform x:Name="CanvasTranslate"
                                                        X="{Binding UnifilarDiagram.PanX, FallbackValue=0}"
                                                        Y="{Binding UnifilarDiagram.PanY, FallbackValue=0}"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>

                            <!-- Linha de conexão do Transformador ao Nó Raiz do Circuito -->
                            <ItemsControl ItemsSource="{Binding UnifilarDiagram.Transformers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas IsItemsHost="True"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas>
                                            <Line X1="{Binding X}" Y1="{Binding Y}" X2="{Binding X, ConverterParameter=50}" Y2="{Binding Y}"
                                                  Stroke="#0284C7" StrokeThickness="3" StrokeDashArray="2,1"/>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Camada 1: ARESTAS (Trechos elétricos da rede) -->
                            <ItemsControl ItemsSource="{Binding UnifilarDiagram.Edges}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas Cursor="Hand" MouseLeftButtonDown="Edge_MouseLeftButtonDown" Tag="{Binding EdgeId}">
                                            <!-- Linha de fundo para área de clique ampliada -->
                                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                                  Stroke="Transparent" StrokeThickness="14"/>

                                            <!-- Linha representativa do trecho -->
                                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}">
                                                <Line.Style>
                                                    <Style TargetType="Line">
                                                        <Setter Property="Stroke" Value="#38BDF8"/>
                                                        <Setter Property="StrokeThickness" Value="3.5"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOverloaded}" Value="True">
                                                                <Setter Property="Stroke" Value="#EF4444"/>
                                                                <Setter Property="StrokeThickness" Value="4.5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Stroke" Value="#FBBF24"/>
                                                                <Setter Property="StrokeThickness" Value="5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Line.Style>
                                            </Line>

                                            <!-- Badge textual informativo centralizado no trecho -->
                                            <Border CornerRadius="4" Padding="4,2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                                    Canvas.Left="{Binding X1}" Canvas.Top="{Binding Y1}">
                                                <Border.RenderTransform>
                                                    <TranslateTransform X="25" Y="-16"/>
                                                </Border.RenderTransform>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ConductorKey}" Foreground="#94A3B8" FontSize="9" FontWeight="SemiBold"/>
                                                    <TextBlock Text=" · ΔV " Foreground="#64748B" FontSize="9"/>
                                                    <TextBlock Text="{Binding SegmentVoltageDropPercent, StringFormat='{}{0:F2}%'}" Foreground="#38BDF8" FontSize="9" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Camada 2: TRANSFORMADORES -->
                            <ItemsControl ItemsSource="{Binding UnifilarDiagram.Transformers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" Cursor="Hand" MouseLeftButtonDown="Transformer_MouseLeftButtonDown" Tag="{Binding TransformerId}">
                                            <Border Width="110" Height="68" CornerRadius="8" Background="#1E293B" Padding="8,6" Margin="-55,-34,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="#0284C7"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#FBBF24"/>
                                                                <Setter Property="BorderThickness" Value="3"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="⚡ " Foreground="#FBBF24" FontSize="10"/>
                                                        <TextBlock Text="{Binding ExternalKey}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding NominalPowerKva, StringFormat='{}{0:F0} kVA'}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding ImpedancePercent, StringFormat='{}Z: {0:F1}%'}" Foreground="#94A3B8" FontSize="9" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Camada 3: NÓS (Barras / Pontos da rede) -->
                            <ItemsControl ItemsSource="{Binding UnifilarDiagram.Nodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" Cursor="Hand" MouseLeftButtonDown="Node_MouseLeftButtonDown" Tag="{Binding NodeId}">
                                            <!-- Nó Visual: Caixa de Identificação com métricas calculadas -->
                                            <Border MinWidth="74" Height="48" CornerRadius="6" Background="#1E293B" Padding="6,4" Margin="-37,-24,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="#475569"/>
                                                        <Setter Property="BorderThickness" Value="1.5"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NodeType}" Value="Source">
                                                                <Setter Property="BorderBrush" Value="#0284C7"/>
                                                                <Setter Property="BorderThickness" Value="2.5"/>
                                                                <Setter Property="Background" Value="#0F2847"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NodeType}" Value="Terminal">
                                                                <Setter Property="BorderBrush" Value="#10B981"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NodeType}" Value="Branch">
                                                                <Setter Property="BorderBrush" Value="#A855F7"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#FBBF24"/>
                                                                <Setter Property="BorderThickness" Value="3"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <StackPanel VerticalAlignment="Center">
                                                    <!-- Chave Externa do Nó -->
                                                    <TextBlock Text="{Binding ExternalKey}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>

                                                    <!-- Queda Acumulada CA% -->
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                        <TextBlock Text="CA: " Foreground="#64748B" FontSize="9"/>
                                                        <TextBlock Text="{Binding AccumulatedVoltageDropPercent, StringFormat='{}{0:F2}%'}" Foreground="{StaticResource AccentCyan}" FontWeight="SemiBold" FontSize="9"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Border>
                </Grid>
            </Border>

            <!-- 3B. Splitter Vertical -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- 3C. Painel Lateral de Detalhes do Elemento Selecionado -->
            <Border Grid.Column="2" Background="{StaticResource CardBg}" CornerRadius="8" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Padding="14">
                <Grid>
                    <!-- Estado Sem Seleção -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UnifilarDiagram.SelectedDetail}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="🔍" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="Painel de Detalhes" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Selecione um Nó, Trecho ou Transformador no unifilar para inspecionar parâmetros elétricos e Half-way BIM."
                                   TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="12,6,12,0"/>
                    </StackPanel>

                    <!-- Estado Com Elemento Selecionado -->
                    <DockPanel LastChildFill="True">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UnifilarDiagram.SelectedDetail}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>

                        <!-- Cabeçalho do Elemento Selecionado -->
                        <Border DockPanel.Dock="Top" Background="#0F172A" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding UnifilarDiagram.SelectedDetail.Title}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="13"/>
                                    <TextBlock Text="{Binding UnifilarDiagram.SelectedDetail.Subtitle}" Foreground="{StaticResource AccentCyan}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Click="BtnClearSelection_Click" Content="✕" ToolTip="Fechar seleção"
                                        Background="Transparent" Foreground="{StaticResource TextSecondary}" BorderThickness="0" FontSize="13" FontWeight="Bold" Cursor="Hand" Padding="6,2"/>
                            </Grid>
                        </Border>

                        <!-- Lista de Categorias de Metadados -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding UnifilarDiagram.SelectedDetail.Categories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Background="#131D2F" CornerRadius="6" Padding="10,8" BorderBrush="#24334A" BorderThickness="1">
                                            <StackPanel>
                                                <!-- Título da Categoria -->
                                                <TextBlock Text="{Binding CategoryName}" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>

                                                <!-- Itens de chave/valor da categoria -->
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Value}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="11"/>
                                                                    <TextBlock Text="{Binding Unit, StringFormat='{} {0}'}" Foreground="#64748B" FontSize="10" Margin="2,0,0,0"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Splitter Horizontal -->
        <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNS"/>

        <!-- 5. Bottom Panel: Segments DataGrid -->
        <Border Grid.Row="5" Margin="18,4,18,8" Background="{StaticResource CardBg}" CornerRadius="8" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Segments}" SelectedItem="{Binding SelectedSegment, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Background="Transparent" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                      BorderThickness="0" HeadersVisibility="Column" SelectionMode="Single"
                      Foreground="{StaticResource TextPrimary}" RowBackground="#1E293B" AlternatingRowBackground="#182234">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0F172A"/>
                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderBrush" Value="#334155"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="FontSize" Value="11"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Trecho" Binding="{Binding FromTo}" Width="110"/>
                    <DataGridTextColumn Header="Condutor" Binding="{Binding Conductor}" Width="140"/>
                    <DataGridTextColumn Header="Comp. (m)" Binding="{Binding LengthMeters, StringFormat='{}{0:F1}'}" Width="80"/>
                    <DataGridTextColumn Header="Carga (kVA)" Binding="{Binding LoadKva, StringFormat='{}{0:F2}'}" Width="90"/>
                    <DataGridTextColumn Header="Ib (A)" Binding="{Binding OperatingCurrentAmperes, StringFormat='{}{0:F1}'}" Width="75"/>
                    <DataGridTextColumn Header="Iz (A)" Binding="{Binding RatedAmpacityAmperes, StringFormat='{}{0:F0}'}" Width="70"/>
                    <DataGridTextColumn Header="Temp. (°C)" Binding="{Binding TemperatureCelsius, StringFormat='{}{0:F1}'}" Width="80"/>
                    <DataGridTextColumn Header="ΔV Trecho (%)" Binding="{Binding SegmentVoltageDropPercent, StringFormat='{}{0:F3}'}" Width="100"/>
                    <DataGridTextColumn Header="Icc 3φ (A)" Binding="{Binding ShortCircuit3PhaseAmperes, StringFormat='{}{0:F0}'}" Width="90"/>
                    <DataGridTextColumn Header="Icc 1φ (A)" Binding="{Binding ShortCircuit1PhaseAmperes, StringFormat='{}{0:F0}'}" Width="90"/>
                    <DataGridTextColumn Header="Condição" Binding="{Binding OverloadStatus}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 6. Footer Bar (Observabilidade & Rastreabilidade) -->
        <Border Grid.Row="6" Background="#0B1120" Padding="18,10" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CorrelationId: " Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    <TextBlock Text="{Binding CorrelationId}" Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,0,14,0"/>

                    <TextBlock Text="Execução: " Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    <TextBlock Text="{Binding ExecutionDurationMs, StringFormat='{}{0:F1} ms'}" Foreground="{StaticResource AccentCyan}" FontSize="11" Margin="0,0,14,0"/>

                    <TextBlock Text="Hash: " Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    <TextBlock Text="{Binding OutputHash}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
